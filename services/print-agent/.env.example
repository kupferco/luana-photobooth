# Where the API lives. Staging while developing; production at a party.
PHOTOBOOTH_API_URL="https://photolu-api-staging-194349492339.europe-west2.run.app"

# The CUPS queue name. Find it with: lpstat -p
PRINTER_NAME="Canon_SELPHY_CP1500"

# Written by `npm run pair` after entering a pairing code; not set by hand.
# DEVICE_TOKEN=""

# Set to 1 to accept jobs and process them without sending anything to a
# printer. Useful on a laptop, or on a Pi before the SELPHY arrives.
DRY_RUN="0"
