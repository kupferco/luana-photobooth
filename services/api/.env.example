# Neon pooled connection string. Create the project at console.neon.tech in
# AWS eu-west-2 (London) so it sits next to the GCS bucket.
#
# Use the POOLED string (it has "-pooler" in the host). Note that the pooled
# endpoint is pgbouncer in transaction mode, so LISTEN/NOTIFY is unavailable
# there -- see docs/architecture.md.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-west-2.aws.neon.tech/photolu?sslmode=require"

GCP_PROJECT_ID="photolu"
GCS_BUCKET="photolu-media"

# Resend, for sign-in codes and guest photo links.
RESEND_API_KEY=""

PORT="8080"

# Sender. onboarding@resend.dev works without verifying a domain, but Resend
# will only deliver to the address that owns the account -- fine for testing,
# not for guests. Switch to a verified domain before the party.
RESEND_FROM="Photo Booth <onboarding@resend.dev>"

# Signing key for access tokens. Generate with: openssl rand -base64 48
JWT_SECRET=""
ACCESS_TOKEN_TTL="900"
REFRESH_TOKEN_TTL="5184000"
