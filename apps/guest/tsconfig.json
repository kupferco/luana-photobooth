{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "paths": {
      "@photobooth/shared": ["../../packages/shared/src/index.ts"],
      "@dk/ui-tokens": ["../../packages/ui-tokens/src/index.ts"],
      "@dk/ui-tokens/themes/*": ["../../packages/ui-tokens/themes/*"],
      "@dk/i18n": ["../../packages/i18n/src/index.ts"]
    }
  },
  "include": ["src/**/*", "vite.config.ts"]
}
