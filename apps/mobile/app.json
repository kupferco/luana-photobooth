{
  "expo": {
    "name": "Photo Booth",
    "slug": "photobooth",
    "version": "0.1.0",
    "scheme": "photobooth",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.kupfer.photobooth",
      "infoPlist": {
        "NSCameraUsageDescription": "The photo booth uses the camera to take your party photos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "co.kupfer.photobooth",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "The photo booth uses the camera to take your party photos."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
