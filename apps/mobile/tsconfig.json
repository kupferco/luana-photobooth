{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@photobooth/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@dk/ui-tokens": [
        "../../packages/ui-tokens/src/index.ts"
      ],
      "@dk/ui-tokens/themes/*": [
        "../../packages/ui-tokens/themes/*"
      ],
      "@dk/i18n": [
        "../../packages/i18n/src/index.ts"
      ]
    },
    "resolveJsonModule": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
